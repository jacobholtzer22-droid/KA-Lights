{
  "name": "aa-site-template",
  "version": "1.0.0",
  "private": true,
  "description": "Align & Acquire client site template. Facts live in site.config.ts, prose in content/, and scripts/verify.ts gates every build.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "images": "tsx scripts/process-images.ts",
    "verify": "next build && tsx scripts/verify.ts",
    "typecheck": "tsc --noEmit",
    "seal-contact-form": "tsx scripts/seal-contact-form.ts",
    "gate": "node scripts/launch-gate.mjs"
  },
  "dependencies": {
    "next": "14.2.21",
    "next-mdx-remote": "^5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "cheerio": "^1.0.0",
    "postcss": "^8.4.38",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}
